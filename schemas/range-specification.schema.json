{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/range-specification.schema.json",
  "title": "RangeSpecification",
  "type": "object",
  "required": ["ranges", "output_constraints", "error_ranges", "assumptions"],
  "properties": {
    "ranges": {"type": "array", "items": {"$ref": "#/$defs/inputRange"}},
    "output_constraints": {"type": "array", "items": {"$ref": "#/$defs/outputConstraint"}},
    "error_ranges": {"type": "object", "additionalProperties": {"$ref": "#/$defs/inputRange"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "inputRange": {
      "type": "object",
      "required": ["name", "lower", "upper", "lower_closed", "upper_closed", "dimensions", "shape", "assumptions", "status", "provenance"],
      "properties": {
        "name": {"type": "string"}, "lower": {}, "upper": {},
        "lower_closed": {"type": "boolean"}, "upper_closed": {"type": "boolean"},
        "module": {"type": ["string", "null"]}, "function": {"type": ["string", "null"]},
        "root": {"type": ["string", "null"]}, "dimensions": {"type": "array", "items": {"type": "string"}},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "item_count": {"type": ["integer", "null"], "minimum": 0},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}, "provenance": {"type": "object"}
      }
    },
    "outputConstraint": {
      "type": "object",
      "required": ["output", "lower", "upper", "lower_closed", "upper_closed"],
      "properties": {"output": {"type": "string"}, "lower": {}, "upper": {}, "lower_closed": {"type": "boolean"}, "upper_closed": {"type": "boolean"}}
    }
  }
}
