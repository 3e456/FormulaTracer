{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-audit.dev/schemas/library-contract-registry-0.1.json",
  "type": "object",
  "required": ["schema_version", "package", "version", "verified_date"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "resolution_kind": {"enum": ["REFERENCE_SIMPLE_MAPPING", "REFERENCE_DETAILED_CONTRACT", "REGISTERED_CONTRACT"]},
    "reference_status": {"enum": ["REFERENCE_EXTRACTED", "REFERENCE_REVIEWED", "REFERENCE_TEST_VALIDATED", "LEAN_VERIFIED_MAPPING"]},
    "verified_date": {"type": "string", "format": "date"},
    "reference": {"type": "string"},
    "reference_template": {"type": "string"},
    "references": {"type": "object", "additionalProperties": {"type": "string"}},
    "equivalence_scope": {"$ref": "#/$defs/scope"},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "simple_bindings": {"type": "object"}
  },
  "$defs": {
    "scope": {"type": "object", "required": ["preserve", "ignore"],
      "properties": {"preserve": {"type": "array", "items": {"type": "string"}},
                     "ignore": {"type": "array", "items": {"type": "string"}}}},
    "binding": {"type": "object", "required": ["callable", "family", "bind"],
      "properties": {"callable": {"type": "string"}, "family": {"type": "string"},
                     "bind": {"type": "object"}, "reference": {"type": "string"},
                     "reference_status": {"type": "string"}, "verified_date": {"type": "string"},
                     "equivalence_scope": {"$ref": "#/$defs/scope"}, "execution": {"type": "object"},
                     "return_type": {"$ref": "#/$defs/returnType"}}},
    "returnType": {"type": "object", "required": ["kind", "evidence"],
      "properties": {
        "kind": {"type": "string"},
        "evidence": {"enum": ["REFERENCE_DETERMINED", "INPUT_TYPE_DETERMINED",
          "STATICALLY_CONSTRAINED", "ANNOTATION_DETERMINED", "AMBIGUOUS", "UNKNOWN"]},
        "cases": {"type": "array", "items": {"type": "object", "required": ["when", "returns"],
          "properties": {"when": {"type": "object"}, "returns": {"type": "string"}}}}
      }}
  }
}
