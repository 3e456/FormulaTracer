{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/audit-certificate.schema.json",
  "type": "object",
  "required": ["status", "audit_id", "target", "control_flow_summary", "numeric_type_semantics", "ieee754_semantics", "parallel_semantics", "allowed_transformation_sets", "transformation_trace", "transformed_theory", "applied_rules", "rejected_rules", "remaining_obligations", "comparison_relation", "residual_candidate", "approximation_proofs", "approximation_coverage", "residual_expression", "error_specification", "error_components", "error_composition", "proof_obligations", "graph_enclosure", "error_summary", "inputs", "constants", "theory", "implementation", "comparison", "output", "library_contracts", "lean", "verification_certificate", "diagnostics"],
  "properties": {
    "status": {"enum": ["LEAN_KERNEL_VERIFIED", "LEAN_KERNEL_VERIFIED_UNDER_ASSUMPTIONS", "PARTIALLY_KERNEL_VERIFIED", "REFERENCE_CONTRACT_VERIFIED", "VERIFICATION_FAILED"]},
    "audit_id": {"type": "string"},
    "target": {"type": "object"},
    "control_flow_summary": {"type": "object", "required": ["cfg_status", "branch_count", "loop_count", "mutation_count", "alias_status", "exception_paths", "termination_status", "unresolved_control_flow"]},
    "numeric_type_semantics": {"$ref": "numeric-type-semantics.schema.json"},
    "ieee754_semantics": {"$ref": "ieee754-semantics.schema.json"},
    "parallel_semantics": {"$ref": "parallel-semantics.schema.json"},
    "allowed_transformation_sets": {"type": "array"},
    "transformation_trace": {
      "type": "object",
      "required": ["source_expression_id", "target_expression_id", "applications"],
      "properties": {"applications": {"type": "array", "items": {"$ref": "transformation-application.schema.json"}}}
    },
    "transformed_theory": {"type": ["object", "null"]},
    "applied_rules": {"type": "array"}, "rejected_rules": {"type": "array"},
    "remaining_obligations": {"type": "array"},
    "comparison_relation": {"enum": ["EXACT_EQUAL", "EQUIVALENT_UNDER_ASSUMPTIONS", "DISCRETIZATION_OF", "APPROXIMATION_OF", "REFINEMENT_OF", "PARTIAL_IMPLEMENTATION_OF", "INCONSISTENT_WITH", "NOT_COMPARABLE"]},
    "residual_candidate": {"type": ["object", "null"]},
    "approximation_proofs": {"type": "array"},
    "approximation_coverage": {"type": "array"},
    "residual_expression": {"type": "object"},
    "error_specification": {"type": "object"},
    "error_components": {"type": "array", "items": {"type": "object"}},
    "error_composition": {"type": "object", "required": ["kind", "rule", "status", "component_ids", "cancellation_assumed"]},
    "proof_obligations": {"type": "array", "items": {"type": "object"}},
    "graph_enclosure": {"type": "object"},
    "error_summary": {"type": "object", "required": ["component_status", "total_status"]},
    "inputs": {"type": "array"},
    "constants": {"$ref": "constant-dependency-graph.schema.json"},
    "theory": {"type": ["object", "null"]},
    "implementation": {"type": "object"},
    "comparison": {"type": ["object", "null"]},
    "output": {"type": "object"},
    "library_contracts": {"type": "array"},
    "lean": {"type": "object", "required": ["status", "source_sha256", "lean_version", "mathlib_version", "theorem_names", "assumptions", "claims"]},
    "verification_certificate": {"type": "object", "required": ["audit_id", "source_hash", "theory_expression_hash", "implementation_expression_hash", "constant_graph_hash", "numeric_type_semantics_hash", "ieee754_semantics_hash", "parallel_semantics_hash", "transformation_trace_hash", "library_contract_registry_hash", "lean_source_hash", "lean_version", "mathlib_version", "verified_theorem_names", "assumptions", "result"]},
    "diagnostics": {"type": "array"}
  },
  "additionalProperties": false
}
