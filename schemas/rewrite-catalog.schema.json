{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/rewrite-catalog.schema.json",
  "title": "Bounded rewrite catalog",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "defaults": {"type": "object"},
    "rules": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["rule_id", "relation_kind", "preconditions", "domain_constraints", "type_constraints",
                   "shape_constraints", "assumptions", "cost", "priority", "evidence", "inverse_rule", "motifs"],
      "properties": {
        "rule_id": {"type": "string"},
        "relation_kind": {"enum": ["EXACT", "EXACT_UNDER_ASSUMPTIONS", "ALGEBRAIC_EQUIVALENCE",
          "IDENTITY_UNDER_ASSUMPTIONS", "TRANSFORMATION", "APPROXIMATION", "DISCRETIZATION", "TRUNCATION",
          "NUMERICALLY_NON_EQUIVALENT"]},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "domain_constraints": {"type": "array", "items": {"type": "string"}},
        "type_constraints": {"type": "array", "items": {"type": "string"}},
        "shape_constraints": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "integer", "minimum": 0}, "priority": {"type": "integer"},
        "evidence": {"type": ["string", "null"]}, "inverse_rule": {"type": ["string", "null"]},
        "motifs": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": true
}
