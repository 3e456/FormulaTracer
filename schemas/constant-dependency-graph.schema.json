{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/constant-dependency-graph.schema.json",
  "type": "object",
  "required": ["nodes", "edges", "sha256"],
  "properties": {
    "nodes": {"type": "array", "items": {"type": "object", "required": ["symbol", "kind", "definition", "dependencies", "resolved_value", "source"]}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["source", "target"]}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
