{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/rust-library-contract.schema.json",
  "title": "RustLibraryContract",
  "type": "object",
  "required": ["crate_name", "crate_version", "public_symbol", "official_reference", "contract_version", "semantic_family", "mathematical_operation", "execution_semantics", "resolution_status"],
  "properties": {
    "crate_name": {"type": "string"},
    "crate_version": {"type": "string"},
    "public_symbol": {"type": "string"},
    "official_reference": {"type": "string", "format": "uri"},
    "contract_version": {"type": "string"},
    "semantic_family": {"type": "string"},
    "mathematical_operation": {"type": "string"},
    "execution_semantics": {"type": "object"},
    "resolution_status": {"const": "REFERENCE_CONTRACT_RESOLVED"}
  }
}
