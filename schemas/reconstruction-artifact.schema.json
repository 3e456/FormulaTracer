{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formulatracer.dev/schemas/reconstruction-artifact.schema.json",
  "title": "FormulaTracer reconstruction artifact",
  "type": "object",
  "required": [
    "schema_version", "case_id", "split", "reference_id", "reference_version_or_revision",
    "original_theory_tex", "original_theory_ir", "normalized_theory_ir",
    "theory_structural_quotient", "generation_plan", "selected_provider",
    "generation_decision", "algorithm_ir", "generated_language",
    "generated_source_fingerprint", "observed_implementation_ir",
    "reconstructed_math_ir", "reconstructed_structural_quotient",
    "structural_isomorphism_status", "structural_isomorphism_witness",
    "exact_egraph_status", "relation_graph_status", "assumptions",
    "error_range_evidence", "final_reconstruction_status",
    "implementation_provenance", "loop_reduction_provenance",
    "semantic_fingerprint", "external_source_retained", "unavailable_reasons",
    "artifact_payload_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "reference_id": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "reference_version_or_revision": {"type": "object", "additionalProperties": {"type": "string"}},
    "original_theory_tex": {"type": "string"},
    "original_theory_ir": {"type": "object"},
    "normalized_theory_ir": {"type": "object"},
    "theory_structural_quotient": {"type": "object"},
    "generation_plan": {"type": "object"},
    "selected_provider": {"type": ["object", "null"]},
    "generation_decision": {"type": ["object", "null"]},
    "algorithm_ir": {"type": ["object", "null"]},
    "generated_language": {"type": ["string", "null"]},
    "generated_source_fingerprint": {"type": ["string", "null"]},
    "observed_implementation_ir": {"type": ["object", "null"]},
    "reconstructed_math_ir": {"type": ["object", "null"]},
    "reconstructed_structural_quotient": {"type": ["object", "null"]},
    "structural_isomorphism_status": {"type": ["string", "null"]},
    "structural_isomorphism_witness": {"type": ["object", "null"]},
    "exact_egraph_status": {"type": ["string", "null"]},
    "relation_graph_status": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "error_range_evidence": {"type": ["object", "null"]},
    "final_reconstruction_status": {"type": "string"},
    "implementation_provenance": {"type": "object"},
    "loop_reduction_provenance": {"type": "object"},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_source_retained": {"const": false},
    "unavailable_reasons": {"type": "object", "additionalProperties": {"type": "string"}},
    "artifact_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
