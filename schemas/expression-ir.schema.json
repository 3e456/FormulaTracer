{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-audit.dev/schemas/expression-ir-0.1.json",
  "type": "object",
  "required": ["schema_version", "status", "outputs", "numeric_domain", "source_correspondence"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["EXPRESSION_EXTRACTED", "EXPRESSION_PARTIALLY_EXTRACTED", "EXPRESSION_EXTRACTION_FAILED"]},
    "expression_id": {"type": "string"},
    "numeric_domain": {"$ref": "#/$defs/numericDomain"},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
    "source_correspondence": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array"}
  },
  "$defs": {
    "numericDomain": {
      "type": "object", "required": ["category"],
      "properties": {"category": {"type": "string"}, "radix": {"type": "integer"},
        "signedness": {"type": "string"}, "precision": {"type": "integer"},
        "lower_bound": {}, "upper_bound": {}, "rounding": {"type": "string"},
        "supports_nan": {"type": "boolean"}, "supports_infinity": {"type": "boolean"},
        "supports_signed_zero": {"type": "boolean"}}
    },
    "output": {"type": "object", "required": ["target", "expression"],
      "properties": {"target": {"$ref": "#/$defs/node"}, "expression": {"$ref": "#/$defs/node"},
        "index_domain": {"type": "object"}}},
    "node": {"type": "object", "required": ["op"], "properties": {
      "op": {"enum": ["Input", "Output", "BoundVariable", "FreeVariable", "Constant", "IndexedValue",
        "Intermediate", "FunctionValue", "Add", "Subtract", "Multiply", "Divide", "Power", "Negate",
        "Compare", "IfThenElse", "FiniteSum", "FiniteProduct", "Map", "Filter", "FoldLeft", "Reduce",
        "TransformReduce", "Scan", "Cast", "FunctionCall", "Derivative", "Integral", "Limit", "InfiniteSum",
        "Piecewise", "FunctionComposition", "TensorContraction", "ShapeTransform",
        "RepresentationMapping", "IndexSelection", "AxisMapping", "Statistics", "Interpolation",
        "LinearAlgebraRelation", "GraphAlgorithm", "SpatialGeometry", "RandomSample", "Distribution",
        "AlgorithmInvocation", "TableMapping", "Grouping", "Aggregation", "Alignment",
        "OpaqueNumericCall"]},
      "args": {"type": "array", "items": {"$ref": "#/$defs/node"}}, "name": {"type": "string"},
      "value": {}, "indices": {"type": "array", "items": {"$ref": "#/$defs/node"}}
    }, "additionalProperties": true}
  }
}
